{
    "$schema": "https://openapi.vercel.sh/vercel.json",
    "regions": [
        "sin1"
    ],
    "functions": {
        "api/resume.go": {
            "memory": 512,
            "maxDuration": 60,
            "includeFiles": "assets/hieu_profile.md"
        },
        "api/proxy.go": {
            "memory": 512,
            "maxDuration": 60
        }
    },
    "rewrites": [
        {
            "source": "/api/medium/:path*",
            "destination": "https://medium.com/:path*"
        }
    ]
}